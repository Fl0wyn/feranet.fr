# Base de données du ticketing (libSQL / SQLite).
# En local : un fichier SQLite est créé automatiquement.
DATABASE_URL=file:./data/tickets.db
# En production (ex. Vercel) : utilisez une base Turso
# DATABASE_URL=libsql://<db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=

# Mot de passe d'accès au ticketing.
# Obligatoire en production ; si vide en développement, l'accès est libre.
TICKETS_PASSWORD=

# Formulaire de contact : chaque message crée une demande dans l'espace support.
# Pour recevoir aussi une copie par e-mail, renseignez un serveur SMTP :
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expéditeur (par défaut SMTP_USER) et destinataire (par défaut contact+site@feranet.fr)
SMTP_FROM=
CONTACT_TO=
