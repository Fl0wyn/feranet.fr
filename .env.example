# Base de données du ticketing (libSQL / SQLite).
# En local : un fichier SQLite est créé automatiquement.
DATABASE_URL=file:./data/tickets.db
# En production (ex. Vercel) : utilisez une base Turso
# DATABASE_URL=libsql://<db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=

# Mot de passe d'accès au ticketing.
# Obligatoire en production ; si vide en développement, l'accès est libre.
TICKETS_PASSWORD=

# Formulaire de contact : chaque message crée une demande dans l'espace support.
# Pour recevoir aussi une copie par e-mail, installez l'intégration Resend du Vercel Marketplace :
# elle ajoute RESEND_API_KEY au projet automatiquement.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
# Destinataire (par défaut contact+site@feranet.fr). Tant que le domaine n'est pas vérifié
# dans Resend, utilisez l'adresse du compte Resend.
CONTACT_TO=
# Expéditeur. Par défaut : site@<RESEND_EMAIL_DOMAIN> (fourni par l'intégration Resend).
CONTACT_FROM=
